{
  "rules": {
    "rooms": {
      "$room": {
        "config": {
          ".read": false,
          ".write": "!data.exists()",
          "pin": { ".validate": "newData.isString() && newData.val().length >= 4" }
        },
        "token": { ".read": false, ".write": true },
        "state": {
          ".read": true,
          ".write": "newData.parent().child('token').val() === root.child('rooms/' + $room + '/config/pin').val()"
        },
        "students": {
          ".read": true,
          "$seat": { ".write": true, ".validate": "newData.hasChild('t')" }
        },
        "answers": {
          ".read": true,
          "$session": {
            "$qid": {
              "$seat": {
                ".write": "root.child('rooms/' + $room + '/state/open').val() === true && root.child('rooms/' + $room + '/state/qid').val() === $qid && root.child('rooms/' + $room + '/state/session').val() === $session",
                ".validate": "newData.child('v').isString() && newData.child('v').val().length <= 200"
              }
            }
          }
        },
        "key": {
          ".read": false,
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "pics": {
          ".read": true,
          ".write": "newData.parent().child('key').val() !== data.parent().child('key').val() && newData.parent().child('key').val().beginsWith(root.child('rooms/' + $room + '/config/pin').val() + ':')",
          ".validate": "newData.isNumber()"
        },
        "gallery": {
          ".read": "root.child('rooms/' + $room + '/pics').isNumber() && root.child('rooms/' + $room + '/pics').val() > 0 && root.child('rooms/' + $room + '/pics').val() + 5400000 > now",
          ".write": "newData.parent().child('key').val() !== data.parent().child('key').val() && newData.parent().child('key').val().beginsWith(root.child('rooms/' + $room + '/config/pin').val() + ':')",
          "$set": {
            "$id": { ".validate": "newData.isString() && newData.val().length < 1500000" }
          }
        }
      }
    }
  }
}
